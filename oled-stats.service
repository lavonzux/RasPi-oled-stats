[Unit]
Description=OLED Stats Display
After=network.target

[Service]
ExecStart=/home/lavonzux/oled-stats/.venv/bin/python /home/lavonzux/oled-stats/oled_stats.py
WorkingDirectory=/home/lavonzux/oled-stats
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=5
User=lavonzux
TimeoutStopSec=5
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
